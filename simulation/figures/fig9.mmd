flowchart LR
  subgraph S1["1. One short daily form"]
    direction TB
    A2["Four Hooper items:<br/>sleep, stress,<br/>fatigue and soreness"]
    A1["Session duration<br/>and RPE"]
    A1 ~~~ A2
  end
  subgraph S2["2. Analysis by HBOD"]
    direction TB
    B1["sRPE updates fitness<br/>and fatigue states"]
    B2["Hooper items update<br/>wellness strain"]
    B3["Missing report widens<br/>uncertainty; silence is<br/>not read as rest"]
    B4["Personal coefficients<br/>learned by recursive<br/>least squares"]
    B1 ~~~ B2 ~~~ B3 ~~~ B4
  end
  subgraph S3["3. Daily report to staff"]
    direction TB
    C1["Posterior probability<br/>for every athlete"]
    C2["Fixed alert budget,<br/>about 10% of healthy<br/>athlete-days (two athletes<br/>in a squad of 25)"]
    C3["Acute and chronic loads<br/>shown separately for<br/>planning; no ACWR trigger"]
    C1 --> C2
    C2 ~~~ C3
  end
  subgraph S4["4. Decision by the coach"]
    direction TB
    D1["Check-in with each<br/>flagged athlete"]
